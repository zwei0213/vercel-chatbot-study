# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Study pages /study/a and /study/b use DeepSeek directly.
DEEPSEEK_API_KEY=****
# A long random value used only for downloading the study transcript CSV.
STUDY_ADMIN_TOKEN=****
# Optional: fixed number of messages sent by each participant; leave unset until decided.
# STUDY_MAX_EXCHANGES=6
